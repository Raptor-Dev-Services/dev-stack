# =============================================================================
# actions-runner/.env.example - copia a .env (NO se versiona) y ajusta
# =============================================================================
#     cp .env.example .env
#
# Los valores de ejemplo son los de raptor-server. Los ids del host se sacan con:
#     id -u                                   -> RUNNER_UID
#     id -g                                   -> RUNNER_GID
#     getent group docker | cut -d: -f3       -> DOCKER_GID
#     echo $HOME                              -> HOST_HOME
# =============================================================================

# A que se registran los runners: la ORGANIZACION (sirven para todos sus repos).
GITHUB_URL=https://github.com/Raptor-Dev-Services

# Token de REGISTRO: GitHub > organizacion > Settings > Actions > Runners > New self-hosted runner
# (es el valor que aparece despues de `--token` en las instrucciones). Caduca en UNA hora y solo se usa
# en el primer arranque de cada runner: registra los que falten y despues se puede vaciar. Un runner
# que pase 14 dias apagado se da de baja en GitHub y necesitaria uno nuevo.
RUNNER_TOKEN=

# Nombre de los runners en GitHub: <prefijo>-1 .. <prefijo>-4. UNICO POR MAQUINA: si dos PCs usan el
# mismo prefijo, el registro con --replace de una le quita los runners a la otra sin avisar. Usa el
# nombre de la maquina (raptor-server, laptop, ...).
RUNNER_NAME_PREFIX=raptor-server
# Grupo de runners de la organizacion.
RUNNER_GROUP=Default
# Etiquetas EXTRA, separadas por coma. Las base (self-hosted, Linux, X64) las pone el runner solo, y son
# las que piden hoy los pipelines (`runs-on: [self-hosted, linux]`).
RUNNER_LABELS=docker

# Usuario del host como el que corren los runners (mismos archivos, mismo login de Harbor, mismos .env).
HOST_HOME=/home/raptor
RUNNER_UID=1000
RUNNER_GID=1000
# gid del grupo `docker` del HOST (el de la imagen, 123, no coincide). Vacio a proposito: cambia por
# maquina, y el compose no arranca sin el en vez de adivinarlo.
DOCKER_GID=

# Carpeta de cada runner (su estado y su carpeta de trabajo). Tiene que estar DENTRO de HOST_HOME.
RUNNERS_DIR=/home/raptor/ci-runners

# Version de la imagen oficial. `latest` sigue las versiones del runner, que GitHub exige recientes.
RUNNER_IMAGE_TAG=latest
