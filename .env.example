# =============================================================================
# .env.example - Copia a .env y ajusta lo que necesites
# =============================================================================
# TODO ES OPCIONAL: el compose trae un valor por omision para cada variable, asi que el
# stack levanta sin .env. Sirve para cambiar un puerto que te choque o una credencial.
#
# `.env` NO se versiona. Este `.env.example` si, y por eso aqui no va ningun secreto.
# Compose lee `.env` del directorio del compose, sin pasar --env-file.
#
# Los secretos de cada producto (claves JWT, Stripe, proveedores de identidad...) NO van
# aqui: van en el .env del repo de ese producto.
# =============================================================================

# -----------------------------------------------------------------------------
# Puertos de la infraestructura
# -----------------------------------------------------------------------------
# Solo tocalos si algo mas en la maquina ya usa el puerto. Si cambias POSTGRES_PORT o
# MINIO_API_PORT, cambialo tambien en el .env de cada repo, que tiene las cadenas de conexion.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SEQ_PORT=5341

# -----------------------------------------------------------------------------
# Credenciales de administracion
# -----------------------------------------------------------------------------
# El superusuario solo se usa para administrar (psql, un cliente grafico). Ninguna API se
# conecta con el: cada producto tiene su propio rol owner (ver productos.conf.example).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
