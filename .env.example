# =============================================================================
# .env.example - Copia a .env y ajusta. El .env es OBLIGATORIO.
# =============================================================================
#     cp .env.example .env
#
# El compose no trae ningun valor por omision: cada variable de aqui es requerida, y si
# falta `docker compose` se niega a arrancar diciendo cual. Borrar una linea no la
# "desactiva", rompe el arranque.
#
# `.env` NO se versiona. Este `.env.example` si, y por eso aqui no va ningun secreto: los
# valores de abajo son de desarrollo local. Cambia al menos las contrasenas de Seq y
# Grafana antes del primer arranque. Compose lee `.env` del directorio del compose, sin
# pasar --env-file.
#
# Los secretos de cada producto (claves JWT, Stripe, proveedores de identidad...) NO van
# aqui: van en el .env del repo de ese producto.
# =============================================================================

# -----------------------------------------------------------------------------
# Donde vive este stack
# -----------------------------------------------------------------------------
# En que direccion se publican TODOS los puertos (ver la cabecera de compose-dev.yaml).
#   127.0.0.1 = solo esta maquina (lo seguro)   0.0.0.0 = toda la red (solo con firewall)
DEVSTACK_BIND=127.0.0.1
# Con que nombre llega el NAVEGADOR a esta maquina. Lo usa Dashy para armar sus links:
# localhost en tu equipo, el nombre o la IP del servidor en staging.
DEVSTACK_HOST=localhost

# -----------------------------------------------------------------------------
# Puertos de la infraestructura
# -----------------------------------------------------------------------------
# Si cambias POSTGRES_PORT, MINIO_API_PORT, SEQ_INGESTION_PORT o PROMETHEUS_PORT, cambialo
# tambien en el .env de cada producto, que tiene las cadenas de conexion y los endpoints.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# -----------------------------------------------------------------------------
# Credenciales de administracion
# -----------------------------------------------------------------------------
# El superusuario solo se usa para administrar (psql, un cliente grafico). Ninguna API se
# conecta con el: cada producto tiene su propio rol owner (ver productos.conf.example).
# OJO: la contrasena de Postgres solo se aplica al crear el volumen. Cambiarla aqui con la
# base ya creada no la cambia.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres

# Los productos usan estas mismas credenciales como llaves S3 en desarrollo: si las
# cambias, cambialas tambien en el .env de cada producto.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Monitoreo
# -----------------------------------------------------------------------------
# Seq: la interfaz y la ingesta van en puertos distintos. La ingesta es la que usan los
# productos (Seq__ServerUrl); la interfaz pide usuario y contrasena.
SEQ_UI_PORT=5380
SEQ_INGESTION_PORT=5341
SEQ_ADMIN_USER=admin
# Solo aplica en el primer arranque (./data/seq vacia). Despues se cambia en la interfaz.
SEQ_ADMIN_PASSWORD=cambiame-seq

PROMETHEUS_PORT=9090
# Cuanto historial guarda. Formato de Prometheus: 15d, 12h, 4w...
PROMETHEUS_RETENTION=15d

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Solo aplica en el primer arranque (./data/grafana vacia). Despues se cambia en la interfaz.
GRAFANA_ADMIN_PASSWORD=cambiame-grafana

# El usuario de Uptime Kuma se crea en el asistente del primer arranque, no aqui.
UPTIME_KUMA_PORT=3001

# La pagina de inicio con un link a todo. Los links de los productos van en dashy/productos.yml.
DASHY_PORT=4000
