[Unit]
Description=Vacia las carpetas de trabajo de los runners de CI que esten libres
Documentation=file:///home/usuario/Docker/dev-stack/actions-runner/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=usuario
Group=docker
# La copia del repo que corre en el server; `git pull` alli la actualiza.
ExecStart=/bin/bash /home/usuario/Docker/dev-stack/mantenimiento/limpiar-runners.sh
# Con runners ocupados reintenta cada 10 min, hasta 6 veces: en el peor caso, ~1 h.
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
